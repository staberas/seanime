# This Dockerfile builds and packages the Seanime media server and web interface
# into a single container image. It follows the build steps described in
# the repository's DEVELOPMENT_AND_BUILD.md, using a multi‑stage build to
# minimize the final image size. 

## Stage 1: Build the web interface with Node
FROM --platform=$BUILDPLATFORM node:20-alpine AS web-builder

WORKDIR /usr/src/app
# Copy only the web source to speed up caching. Adjust this pattern if your
# repository layout differs. Here we assume the Next.js/React web code lives
# under `seanime-web`.
COPY seanime-web ./seanime-web

WORKDIR /usr/src/app/seanime-web
# Install dependencies and build the production bundle
RUN npm install --no-fund --no-audit && \
    npm run build

## Stage 2: Build the Go server
# Use the latest Go image and cross‑compile for the target platform.  The
# --platform=$TARGETPLATFORM directive instructs Buildx to set the proper
# GOOS/GOARCH, allowing us to build linux/amd64 and linux/arm64 binaries from a
# single build definition.  We disable CGO to simplify cross‑compilation.
FROM --platform=$TARGETPLATFORM golang:latest AS server-builder

WORKDIR /build

# Copy the entire repository, including the Go source and other assets.
COPY . .

# Copy the built web assets from the previous stage into a `web` folder at the
# repository root. The Go embed directive in main.go (`//go:embed all:web`)
# expects these files to be present under `web` when compiling. Using COPY with
# --from ensures we copy from the web-builder stage rather than relying on a
# path that doesn't exist in this build stage.
COPY --from=web-builder /usr/src/app/seanime-web/out ./web

# Build the statically linked Seanime binary. We use `-trimpath` and strip
# debugging information to reduce size. Tags and flags can be adjusted if
# needed.
ENV CGO_ENABLED=0
RUN go build -o /seanime -trimpath -ldflags="-s -w" .


## Stage 3: Assemble the final image
FROM --platform=$TARGETPLATFORM alpine:3.19

# Install runtime dependencies (e.g. ffmpeg for transcoding, ca-certificates
# for TLS). Adjust packages as necessary for your use case. If you don't need
# ffmpeg, you can omit it to reduce the image size.
RUN apk add --no-cache ffmpeg ca-certificates

WORKDIR /app

# Copy the compiled binary and embedded assets
COPY --from=server-builder /seanime ./seanime
COPY --from=server-builder /build/web ./web

# Expose the default Seanime port
EXPOSE 43211

# Set environment variables to run the server on all interfaces and define
# the default data directory. These can be overridden at runtime if needed.
ENV SEANIME_SERVER_HOST=0.0.0.0
ENV SEANIME_DATA_DIR=/data

CMD ["./seanime"]
